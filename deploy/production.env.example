# Fill in and paste into the Komodo Stack's environment, secrets as Komodo Secrets. Komodo writes it
# next to compose.yml as production.env (docs/runbook.md, "Deploy"). The real values are never committed.
# Every BUNDESARCHIV_* variable the app reads is listed; unset means the documented default.

# --- serving (the app refuses to start without these two) ---------------------------------------
# Signs Django's own machinery. One per deployment: python -c "import secrets; print(secrets.token_urlsafe(64))"
BUNDESARCHIV_SECRET_KEY=change-me
# Comma-separated hostnames the app answers for.
BUNDESARCHIV_ALLOWED_HOSTS=archiv.deutscher-pfadfinderbund.de

# --- database -----------------------------------------------------------------------------------
# The compose service, not localhost. Password must match POSTGRES_PASSWORD below.
BUNDESARCHIV_PG_DSN=postgresql://postgres:change-me@postgres:5432/bundesarchiv
# Read by the postgres service itself (compose.yml).
POSTGRES_DB=bundesarchiv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- storage (container paths; compose binds them to /home/admin/bundesarchiv/) ------------------
# The canonical archive. This is the only data a total loss may not touch.
BUNDESARCHIV_CANONICAL_ROOT=/canonical
# Derived WebP cache: not canonical, not mirrored, not backed up, safe to delete.
BUNDESARCHIV_THUMBNAIL_ROOT=/thumbnails
# Hands media bytes to nginx via X-Accel-Redirect; must match the internal location in
# deploy/nginx/nginx.conf. Unset here would make Django stream every byte itself.
BUNDESARCHIV_X_ACCEL_PREFIX=/_media

# --- authentication (ADR 0018; all four, or nobody can log in) ----------------------------------
# Signs the transient login cookie (OIDC state/nonce). A DIFFERENT secret from BUNDESARCHIV_SECRET_KEY.
BUNDESARCHIV_VIEWER_SIGNING_KEY=change-me
# Must equal the `iss` of the ID token exactly.
BUNDESARCHIV_OIDC_ISSUER=https://auth.deutscher-pfadfinderbund.de/realms/master
# The confidential Keycloak client and its secret (runbook: Keycloak client checklist).
BUNDESARCHIV_OIDC_CLIENT_ID=bundesarchiv
BUNDESARCHIV_OIDC_CLIENT_SECRET=change-me

# --- WebDAV mirror (browse-only convenience copy, never a read path and never backup) ------------
# WARNING: a folder the app owns exclusively — reconcile deletes everything under it that is not
# in canonical. Leave the URL empty to switch the whole mirror off.
BUNDESARCHIV_MIRROR_DAV_URL=https://cloud.deutscher-pfadfinderbund.de/remote.php/dav/files/bundesarchiv-app/Bundesarchiv
BUNDESARCHIV_MIRROR_DAV_USER=bundesarchiv-app
BUNDESARCHIV_MIRROR_DAV_PASSWORD=change-me

# --- cadences and limits (defaults shown; all optional) -----------------------------------------
# Full index rebuild, bounding how stale a missed incremental update can leave search.
BUNDESARCHIV_RECONCILE_CRON=0 * * * *
# Full mirror sweep — coarser, because a briefly stale browse copy harms nothing.
BUNDESARCHIV_MIRROR_RECONCILE_CRON=0 3 * * *
# Per-file upload ceiling, 4 GiB. nginx's client_max_body_size bounds the whole request and
# must stay above this (deploy/nginx/nginx.conf), or nginx answers first and in English.
BUNDESARCHIV_MAX_UPLOAD_BYTES=4294967296
# Form fields per request; the media manager renders one caption input per file.
BUNDESARCHIV_MAX_FORM_FIELDS=2000
# Where collectstatic put the hashed assets inside the image. Change only if the image changes.
BUNDESARCHIV_STATIC_ROOT=/app/static
# gunicorn: one process (ADR 0013), concurrency is threads.
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
