# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local archive data (never commit the archive tree)
/var/
*.local
*.local.*
tests/test_data/archive_items.txt
# Agent scratch worktrees (harness-created, never part of the archive)
.claude/worktrees/

# The deploy stack's real environment file (deploy/production.env.example is the template).
production.env
# The live WebDAV probe's credentials (docs/nextcloud-webdav-notes.md, "Probes").
probe.env

# The VPS deploy folder is a checkout of this repo; its data must never be committed,
# and `git clean` in it must never reach the archive (docs/runbook.md, "Deploy").
/canonical/
/thumbnails/
/pgdata/
